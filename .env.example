# ========================================
# Local PostgreSQL
# ========================================
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/duel_log_app

# ========================================
# Application Auth
# ========================================
JWT_SECRET=dev-jwt-secret
AUTH_CALLBACK_URL=http://localhost:3000/api/auth/oauth/callback
WEB_URL=http://localhost:5173

# ========================================
# Frontend
# ========================================
VITE_API_BASE_URL=http://localhost:3000/api
VITE_MAINTENANCE_BYPASS_KEY=
VITE_ADMIN_EMAILS=

# ========================================
# OBS Overlay JWT
# ========================================
OBS_TOKEN_SECRET=

# ========================================
# Cookie 認証 / CORS
# ========================================
# 認証トークン (dlog_access / dlog_refresh) を入れる httpOnly cookie のドメイン。
# 本番は front ↔ api が codenica.dev のサブドメイン同士 (same-site) なので `.codenica.dev` を指定して共有する。
# dev は未設定でよい (発行ホスト限定)。
COOKIE_DOMAIN=
# credentials 付きリクエストを許可する front の origin (カンマ区切り)。`origin: *` は credentials と併用不可なので明示列挙する。
# 例: https://duel-log.codenica.dev,https://duel-log-staging.codenica.dev
# 未設定なら WEB_URL → http://localhost:5173 にフォールバック。
CORS_ALLOWED_ORIGINS=

# ========================================
# OAuth Providers
# ========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
