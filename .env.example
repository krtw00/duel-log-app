# ========================================
# Supabase Configuration
# ========================================
# ローカル開発: npx supabase start で表示される値を使用
# 本番: Supabase Dashboard > Project Settings > API から取得
SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ========================================
# Database Configuration (API Server / Drizzle)
# ========================================
# ローカル開発: npx supabase start で表示されるDB URLを使用
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# ========================================
# OBS Overlay JWT
# ========================================
# OBSオーバーレイ用のJWTシークレット（設定しない場合はSUPABASE_JWT_SECRETにフォールバック）
OBS_TOKEN_SECRET=
SUPABASE_JWT_SECRET=

# ========================================
# Cookie 認証 / CORS
# ========================================
# 認証トークン (dlog_access / dlog_refresh) を入れる httpOnly cookie のドメイン。
# 本番は front ↔ api が codenica.dev のサブドメイン同士 (same-site) なので `.codenica.dev` を指定して共有する。
# dev は未設定でよい (発行ホスト限定)。
COOKIE_DOMAIN=
# credentials 付きリクエストを許可する front の origin (カンマ区切り)。`origin: *` は credentials と併用不可なので明示列挙する。
# 例: https://duel-log.codenica.dev,https://duel-log-staging.codenica.dev
# 未設定なら WEB_URL → http://localhost:5173 にフォールバック。
CORS_ALLOWED_ORIGINS=

# ========================================
# OAuth Providers (Supabase Auth)
# ========================================
# supabase/config.toml の env() で参照される
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
